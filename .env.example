# ──────────────────────────────────────────────
# Cloudinary Credentials (required)
# Get these from cloudinary.com → Settings → API Keys
# Role needed: Master / Full Access
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ──────────────────────────────────────────────
# Master Admin Password (required)
# Protects the /dashboard admin panel.
# Pick any strong passphrase — this is NOT your Cloudinary key.
# For multiple admins, use a comma-separated list:
# API_KEYS=password1,password2
# ──────────────────────────────────────────────
API_KEYS=your_master_admin_password

# ──────────────────────────────────────────────
# Public App URL (recommended)
# Set this to your deployment domain.
# Used by the AI Integration Prompt and in-app docs
# to show the correct base URL.
# If not set, falls back to window.location.origin (browser only).
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ──────────────────────────────────────────────
# Convex Backend (optional / future hosted version)
# These are only needed if you want to use the Convex integration.
# Not required for standard self-hosting with local JSON database.
# ──────────────────────────────────────────────
# CONVEX_DEPLOYMENT=your_convex_deployment
# NEXT_PUBLIC_CONVEX_URL=your_convex_url
# NEXT_PUBLIC_CONVEX_SITE_URL=your_convex_site_url
